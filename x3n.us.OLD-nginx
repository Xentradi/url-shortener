server {
	server_name x3n.us www.x3n.us;
  include /etc/nginx/snippets/server-hardening.conf;
  include /etc/nginx/snippets/proxy-hardening.conf;

	location / {
		proxy_pass http://localhost:3000;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	location /shorten {
		proxy_pass http://localhost:3000/shorten;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/x3n.us/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/x3n.us/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}

server {
  include /etc/nginx/snippets/server-hardening.conf;

    if ($host = www.x3n.us) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = x3n.us) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


	server_name x3n.us www.x3n.us;
    listen 80;
    return 404; # managed by Certbot




}